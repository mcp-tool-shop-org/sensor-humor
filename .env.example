# sensor-humor reads configuration from process.env — it does NOT auto-load this file.
# Provide these via your MCP client's "env" block (see the README "Configure your MCP client"
# section) or export them in the shell that launches the server. This file is a reference for
# the full set of supported variables, not a file the server loads.

# Ollama model to use for comedy generation (one model for the server — not per-mood routing)
SENSOR_HUMOR_MODEL=qwen2.5:7b

# Scorecard-only model pin (same-base A/B harness). `npm run scorecard -- --model <id>` also works.
# SENSOR_HUMOR_SCORECARD_MODEL=llama3.1:8b

# Ollama host (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama call timeout in ms (default: 30000; invalid/non-numeric values fall back to the default)
SENSOR_HUMOR_TIMEOUT_MS=30000

# Generation temperature, clamped 0.0-2.0 (default: 0.55; invalid values fall back to the default)
SENSOR_HUMOR_TEMPERATURE=0.55

# Enable verbose logging of prompts, raw responses, and generation metadata
SENSOR_HUMOR_DEBUG=false

# Prompt version (loads moods/{mood}.v{version}.prompt.ts, fallback to v1)
SENSOR_HUMOR_PROMPT_VERSION=1

# Persist session to ~/.sensor-humor/session.json so callbacks survive a restart (24h expiry)
SENSOR_HUMOR_PERSIST=false

# Override the session directory (default: ~/.sensor-humor)
# SENSOR_HUMOR_SESSION_DIR=/path/to/dir

# Ollama generation retries on bad output (0-3; default: 1)
SENSOR_HUMOR_MAX_RETRIES=1

# Turns before a planted running_gag becomes a callback candidate (default: 2)
SENSOR_HUMOR_GAG_MIN_DISTANCE=2

# Times a running gag can fire before it retires — the inverted-U of humor repetition (default: 3)
SENSOR_HUMOR_GAG_MAX_FIRES=3

# debug_chain also captures full prompt/raw/parsed text (heavier; off by default)
SENSOR_HUMOR_FULL_TRACE=false

# Bearer token for a remote/cloud Ollama (e.g. OLLAMA_HOST=https://ollama.com); leave unset for local
# OLLAMA_API_KEY=
